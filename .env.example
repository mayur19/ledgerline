# Ledgerline local configuration. ./run.sh copies this to .env and replaces the
# placeholder secret with a random value. Never commit .env.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4101
WEB_PORT=5101
APP_ORIGIN=http://localhost:5101

# Native local PostgreSQL over the Unix socket in /tmp as the current OS user (no password).
DATABASE_URL=postgres:///ledgerline_dev?host=/tmp
TEST_DATABASE_URL=postgres:///ledgerline_test?host=/tmp
DATABASE_POOL_MAX=10

SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=12

LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=50
AUTH_EMAILS_PER_IP_MAX=20
REGISTER_RATE_LIMIT_MAX=5
# false (default), a hop count such as 1, or a comma-separated proxy IP/CIDR list. Never "true".
TRUST_PROXY=false
